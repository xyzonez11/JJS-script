UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.F5 then
        if guiMain then
            guiMain.Visible = not guiMain.Visible
            if guiMain.Visible then
                local scroll = guiMain:FindFirstChild("PlayerScroll", true)
                if scroll then updatePlayerList(scroll) end
            end
        end
    elseif input.KeyCode == Enum.KeyCode.F6 then
        toggleChase()
    elseif input.KeyCode == Enum.KeyCode.F7 then
        -- Đổi chế độ bay
        if CONFIG.Mode == "follow" then
            CONFIG.Mode = "orbit"
            if modeBtn then
                modeBtn.Text = "Vòng quanh"
                modeBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
            end
            notify("🔄 Chuyển sang VÒNG QUANH")
        else
            CONFIG.Mode = "follow"
            if modeBtn then
                modeBtn.Text = "Sau lưng"
                modeBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
            end
            notify("🔄 Chuyển sang SAU LƯNG")
        end
    end
end)

