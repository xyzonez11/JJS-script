function updatePlayerList(scroll)
    for _, child in pairs(scroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local players = Players:GetPlayers()
    local count = 0

    for _, p in pairs(players) do
        if p ~= Player then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 28)
            btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            btn.BackgroundTransparency = 0.95

            local displayText = p.DisplayName
            if p.DisplayName ~= p.Name then
                displayText = p.DisplayName .. " (@" .. p.Name .. ")"
            end
            btn.Text = "  " .. displayText

            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 11
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.AutoButtonColor = false
            btn.Parent = scroll

            btn.MouseButton1Click:Connect(function()
                selectPlayer(p, scroll)
            end)
        end
    end

    scroll.CanvasSize = UDim2.new(0, 0, 0, count * 31)
end

function selectPlayer(p, scroll)
    if not targetNameLabel then return end
    targetNameLabel.Text = p.DisplayName
    if p.DisplayName ~= p.Name then
        targetNameLabel.Text = p.DisplayName .. " (@" .. p.Name .. ")"
    end

    for _, btn in pairs(scroll:GetChildren()) do
        if btn:IsA("TextButton") then
            if btn.Text:find(p.Name) then
                btn.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
                btn.BackgroundTransparency = 0.5
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                btn.BackgroundTransparency = 0.95
                btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end
    end
end

-- ==================== NOCLIP & INVISIBLE ====================
function toggleNoclip(state)
    noclipEnabled = state
    local char = Player.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not state
        end
    end
end

function toggleInvisible(state)
    isInvisible = state
    local char = Player.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = state and 0.9 or 0
            part.CanCollide = not state
        end
    end
end

-- ==================== BẬT/TẮT CHASE ====================
function toggleChase()
    if not isActive then
        if not targetNameLabel or targetNameLabel.Text == "Chưa chọn" then
            notify("⚠️ Vui lòng chọn mục tiêu!")
            return
        end

        local name = targetNameLabel.Text
        if name:find("@") then
            name = name:match("@(.+)%)") or name
        end

        local tp = Players:FindFirstChild(name)
        if not tp then
            notify("⚠️ Không tìm thấy người chơi!")
            return
        end

        if not tp.Character or not tp.Character:FindFirstChild("HumanoidRootPart") then
            notify("⚠️ Mục tiêu chưa spawn!")
            return
        end

        targetPlayer = tp
        isActive = true
        orbitAngle = 0

        toggleBtn.Text = "⏸ TẮT"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        statusDot.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        statusTextLabel.Text = "Đang bám: " .. tp.DisplayName

        if not isInvisible then
            isInvisible = true
            toggleInvisible(true)
            local invBtn = guiMain:FindFirstChild("InvisibleBtn", true)
            if invBtn then
                invBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
                invBtn.Text = "👻 Ẩn ON"
                invBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            end
        end

        notify("✅ Bắt đầu bám " .. tp.DisplayName)
    else
        isActive = false
        targetPlayer = nil

        toggleBtn.Text = "▶ KÍCH HOẠT"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
        statusDot.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
        statusTextLabel.Text = "Đã dừng"

        if isInvisible then
            isInvisible = false
            toggleInvisible(false)
            local invBtn = guiMain:FindFirstChild("InvisibleBtn", true)
            if invBtn then
                invBtn.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
                invBtn.Text = "👻 Ẩn OFF"
                invBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
            end
        end

        notify("⏹ Đã dừng bám")
    end
end

-- ==================== FLY LOOP ====================
local function flyLoop()
    RunService.RenderStepped:Connect(function()
        if not isActive or not targetPlayer then return end

        local char = Player.Character
        local tChar = targetPlayer.Character
        if not char or not tChar then return end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local tHrp = tChar:FindFirstChild("HumanoidRootPart")
        if not hrp or not tHrp then return end

        local dist = (hrp.Position - tHrp.Position).Magnitude

        -- Auto teleport
        if CONFIG.AutoTeleport and dist > CONFIG.MaxDistance then
            local teleportPos = tHrp.CFrame:PointToWorldSpace(Vector3.new(0, 2, CONFIG.TeleportDistance * -1))
            hrp.CFrame = CFrame.new(teleportPos, tHrp.Position)
            return
        end

        -- Anti Fall
        if CONFIG.AntiFall and hrp.Position.Y < -50 then
            local teleportPos = tHrp.CFrame:PointToWorldSpace(Vector3.new(0, 10, CONFIG.FollowDistance * -1))
            hrp.CFrame = CFrame.new(teleportPos, tHrp.Position)
            notify("🔄 Teleport khỏi vực")
            return
        end

        -- Ghost Mode
        if dist > CONFIG.MaxDistance + 15 then
            local behindPos = tHrp.CFrame:PointToWorldSpace(Vector3.new(0, 1, CONFIG.FollowDistance))
            hrp.CFrame = CFrame.new(behindPos, tHrp.Position)
            return
        end

        -- Auto Evade (ưu tiên cao nhất)
        if CONFIG.EvadeEnabled and tick() - lastEvadeTime > CONFIG.EvadeCooldown then
            local danger = false
            -- Kiểm tra nhanh các vật thể nguy hiểm
            for _, obj in pairs(workspace:GetChildren()) do
                if obj:IsA("BasePart") and obj.Parent and obj.Parent:FindFirstChild("Humanoid") then
                    local ohrp = obj.Parent:FindFirstChild("HumanoidRootPart")
                    if ohrp and ohrp ~= hrp and ohrp.Parent ~= targetPlayer then
                        local d = (hrp.Position - ohrp.Position).Magnitude
                        if d < CONFIG.EvadeRange then
                            danger = true
                            break
                        end
                    end
                end
            end
            if danger then
                local dir = (hrp.Position - tHrp.Position).Unit
                local evadePos = hrp.Position + dir * CONFIG.EvadeDistance + Vector3.new(0, 8, 0)
                hrp.CFrame = CFrame.new(evadePos, tHrp.Position)
                lastEvadeTime = tick()
                return  -- Nhảy ra khỏi vòng lặp để không bị kéo ngược
            end
        end

        -- Tính vị trí mới
        local targetPos
        local lookAt = tHrp.Position

        if CONFIG.Mode == "orbit" then
            orbitAngle = orbitAngle + (CONFIG.OrbitSpeed * 0.05)
            local radius = CONFIG.OrbitRadius
            local x = math.cos(orbitAngle) * radius
            local z = math.sin(orbitAngle) * radius
            targetPos = tHrp.Position + Vector3.new(x, 1, z)
            lookAt = tHrp.Position
        else
            targetPos = tHrp.CFrame:PointToWorldSpace(Vector3.new(0, 1, CONFIG.FollowDistance))
            lookAt = tHrp.Position
        end

        -- Xóa body cũ
        for _, v in pairs(hrp:GetChildren()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then
                v:Destroy()
            end
        end

        -- BodyVelocity
        local direction = targetPos - hrp.Position
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        bv.Velocity = direction * CONFIG.Speed
        bv.Parent = hrp

        -- BodyGyro
        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        bg.CFrame = CFrame.new(hrp.Position, lookAt)
        bg.Parent = hrp

        game.Debris:AddItem(bv, 0.1)
        game.Debris:AddItem(bg, 0.1)

        if CONFIG.ShowDistance and statusTextLabel then
            local modeText = CONFIG.Mode == "orbit" and "🔄 Vòng" or "⬆ Sau lưng"
            statusTextLabel.Text = modeText .. " " .. targetPlayer.DisplayName .. " (" .. math.floor(dist) .. "m)"
        end
    end)
end

