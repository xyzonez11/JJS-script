function toggleChase()
    local btn = gui.Main.ToggleBtn
    local dot = gui.Main:FindFirstChild("StatusDot", true)
    local statusText = gui.Main:FindFirstChild("StatusText", true)
    local selName = gui.Main:FindFirstChild("SelectedName", true)
    
    if not isActive then
        if not selName or selName.Text == "Chưa chọn" then
            notify("⚠️ Vui lòng chọn mục tiêu!")
            return
        end
        
        -- Tìm player từ tên gốc
        local targetName = selName.Text
        if targetName:find("@") then
            targetName = targetName:match("@(.+)%)") or targetName
        end
        
        local tp = game.Players:FindFirstChild(targetName)
        if not tp then
            notify("⚠️ Không tìm thấy người chơi!")
            return
        end
        
        if not tp.Character or not tp.Character:FindFirstChild("HumanoidRootPart") then
            notify("⚠️ Người chơi chưa spawn!")
            return
        end
        
        targetPlayer = tp
        isActive = true
        
        btn.Text = "⏸ TẮT"
        btn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        dot.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        statusText.Text = "Đang bám: " .. tp.DisplayName
        
        notify("✅ Bắt đầu bám sát " .. tp.DisplayName)
    else
        isActive = false
        targetPlayer = nil
        
        btn.Text = "▶ KÍCH HOẠT"
        btn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
        dot.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
        statusText.Text = "Đã dừng"
        
        notify("⏹ Đã dừng bám sát")
    end
end

-- BAY NHANH + ĐÚNG SAU LƯNG
local function flyToTarget()
    RunService.RenderStepped:Connect(function()
        if not isActive or not targetPlayer then return end
        
        local char = Player.Character
        local tChar = targetPlayer.Character
        
        if char and tChar then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local tHrp = tChar:FindFirstChild("HumanoidRootPart")
            
            if hrp and tHrp then
                -- Vị trí SAU LƯNG target (dùng CFrame)
                local dist = 5
                local behindPos = tHrp.CFrame:PointToWorldSpace(Vector3.new(0, 0, dist))
                
                -- Xóa BodyVelocity/BodyGyro cũ
                for _, v in pairs(hrp:GetChildren()) do
                    if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then
                        v:Destroy()
                    end
                end
                
                -- Tính velocity NHANH hơn
                local direction = behindPos - hrp.Position
                
                -- BodyVelocity để bay NHANH
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
                bv.Velocity = direction * 20  -- TỐC ĐỘ BAY (20 = nhanh)
                bv.Parent = hrp
                
                -- BodyGyro để xoay mặt
                local bg = Instance.new("BodyGyro")
                bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
                bg.CFrame = CFrame.new(hrp.Position, tHrp.Position)
                bg.Parent = hrp
                
                -- Cleanup
                game.Debris:AddItem(bv, 0.1)
                game.Debris:AddItem(bg, 0.1)
                
                -- Update status
                local statusText = gui.Main:FindFirstChild("StatusText", true)
                if statusText then
                    local d = math.floor((hrp.Position - tHrp.Position).Magnitude)
                    statusText.Text = "Đang bám: " .. targetPlayer.DisplayName .. " (" .. d .. "m)"
                end
            end
        end
    end)
end

