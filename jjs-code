function updatePlayerList()
    local scroll = gui.Main.PlayerScroll
    for _, child in pairs(scroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local players = game.Players:GetPlayers()
    local count = 0
    
    for _, p in pairs(players) do
        if p ~= Player then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 28)
            btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            btn.BackgroundTransparency = 0.95
            
            -- HIỂN THỊ TÊN GỐC + DISPLAY NAME
            local displayText = p.DisplayName
            if p.DisplayName ~= p.Name then
                displayText = p.DisplayName .. " (@" .. p.Name .. ")"
            end
            btn.Text = "  " .. displayText
            
            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 11
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.AutoButtonColor = false
            btn.Parent = scroll
            
            btn.MouseButton1Click:Connect(function()
                selectPlayer(p)
            end)
        end
    end
    
    scroll.CanvasSize = UDim2.new(0, 0, 0, count * 30)
end

function selectPlayer(p)
    local selName = gui.Main:FindFirstChild("SelectedName", true)
    if selName then
        -- HIỂN THỊ TÊN GỐC + DISPLAY NAME
        if p.DisplayName ~= p.Name then
            selName.Text = p.DisplayName .. " (@" .. p.Name .. ")"
        else
            selName.Text = p.DisplayName
        end
    end
    
    local scroll = gui.Main.PlayerScroll
    for _, btn in pairs(scroll:GetChildren()) do
        if btn:IsA("TextButton") then
            if btn.Text:find(p.Name) then
                btn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
                btn.BackgroundTransparency = 0.5
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                btn.BackgroundTransparency = 0.95
                btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end
    end
end

