--  AUTO-UPDATE  LIST  on player join/leave
-- ═══════════════════════════════════════════════
Players.PlayerAdded:Connect(function()
    if isHubOpen then updateList() end
end)

Players.PlayerRemoving:Connect(function(plr)
    if selectedPlayer == plr then
        selectedPlayer = nil
        if isFollowing then
            isFollowing = false
            stopFollow()
            tween(toggleBtn, {BackgroundColor3 = C.accent})
            toggleBtn.Text = "▶  BẮT ĐẦU FOLLOW"
        end
        setStatus("⚠ Mục tiêu đã rời game", C.warn, C.warn)
    end
    if isHubOpen then updateList() end
end)

-- ═══════════════════════════════════════════════
--  CHARACTER RESPAWN
-- ═══════════════════════════════════════════════
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    if isFollowing then
        isFollowing = false
        stopFollow()
        tween(toggleBtn, {BackgroundColor3 = C.accent})
        toggleBtn.Text = "▶  BẮT ĐẦU FOLLOW"
        setStatus("Đã hồi sinh — follow đã dừng", C.textSec, C.textMuted)
    end
end)

