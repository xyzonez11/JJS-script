    txt.Text = msg
    txt.TextColor3 = Color3.fromRGB(255, 255, 255)
    txt.Font = Enum.Font.GothamSemibold
    txt.TextSize = 13
    txt.Parent = notif

    game.Debris:AddItem(notif, 2)
end

function updatePlayerList()
    for _, child in pairs(scroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local players = Players:GetPlayers()
    local count = 0

    for _, p in pairs(players) do
        if p ~= Player then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 28)
            btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            btn.BackgroundTransparency = 0.95

            local displayText = p.DisplayName
            if p.DisplayName ~= p.Name then
                displayText = p.DisplayName .. " (@" .. p.Name .. ")"
            end
            btn.Text = "  " .. displayText

            btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 11
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.AutoButtonColor = false
            btn.Parent = scroll

            btn.MouseButton1Click:Connect(function()
                selectPlayer(p)
            end)
        end
    end

    scroll.CanvasSize = UDim2.new(0, 0, 0, count * 31)
end

function selectPlayer(p)
    targetName.Text = p.DisplayName
    if p.DisplayName ~= p.Name then
        targetName.Text = p.DisplayName .. " (@" .. p.Name .. ")"
    end

    for _, btn in pairs(scroll:GetChildren()) do
        if btn:IsA("TextButton") then
            if btn.Text:find(p.Name) then
                btn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
                btn.BackgroundTransparency = 0.5
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                btn.BackgroundTransparency = 0.95
                btn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
        end
    end
end

function toggleInvisible(state)
    isInvisible = state
    local char = Player.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = state and 0.9 or 0
            part.CanCollide = not state
        end
    end
end

function noclip()
    noclipEnabled = true
    task.spawn(function()
        while noclipEnabled do
            local char = Player.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide == true then
                        part.CanCollide = false
                    end
                end
            end
            task.wait()
        end
    end)
end

function toggleChase()
    if not isActive then
        if targetName.Text == "Chưa chọn" then
            notify("⚠️ Chọn mục tiêu trước!")
            return
        end

        local name = targetName.Text
        if name:find("@") then
            name = name:match("@(.+)%)") or name
        end

        local tp = Players:FindFirstChild(name)
        if not tp then
            notify("⚠️ Không tìm thấy người chơi!")
            return
        end

        if not tp.Character or not tp.Character:FindFirstChild("HumanoidRootPart") then
            notify("⚠️ Mục tiêu chưa spawn!")
            return
        end

        targetPlayer = tp
        isActive = true

        toggleBtn.Text = "⏸ TẮT"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        dot.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        statusText.Text = "Đang bám: " .. tp.DisplayName

        if not isInvisible then
            isInvisible = true
            toggleInvisible(true)
            invisibleBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            invisibleBtn.Text = "👻 Ẩn ON"
            invisibleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end

        notify("✅ Bắt đầu bám " .. tp.DisplayName)
    else
        isActive = false
        targetPlayer = nil

        toggleBtn.Text = "▶ KÍCH HOẠT"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(138, 43, 226)
        dot.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
        statusText.Text = "Đã dừng"

        if isInvisible then
            isInvisible = false
            toggleInvisible(false)
            invisibleBtn.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
            invisibleBtn.Text = "👻 Ẩn OFF"
            invisibleBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
        end

        notify("⏹ Đã dừng bám")
    end
end

-- ==================== FLY LOOP ====================
RunService.RenderStepped:Connect(function()
    if not isActive or not targetPlayer then return end

    local char = Player.Character
    local tChar = targetPlayer.Character

    if not char or not tChar then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local tHrp = tChar:FindFirstChild("HumanoidRootPart")

    if not hrp or not tHrp then return end

    local dist = (hrp.Position - tHrp.Position).Magnitude

    if CONFIG.AutoTeleport and dist > CONFIG.MaxDistance then
        local teleportPos = tHrp.CFrame:PointToWorldSpace(Vector3.new(0, 2, CONFIG.TeleportDistance * -1))
        hrp.CFrame = CFrame.new(teleportPos, tHrp.Position)
        return
    end

    if CONFIG.AntiFall and hrp.Position.Y < -50 then
        local teleportPos = tHrp.CFrame:PointToWorldSpace(Vector3.new(0, 10, CONFIG.FollowDistance * -1))
        hrp.CFrame = CFrame.new(teleportPos, tHrp.Position)
        notify("🔄 Teleport khỏi vực")
        return
    end

    local behindPos = tHrp.CFrame:PointToWorldSpace(Vector3.new(0, 1, CONFIG.FollowDistance))

    for _, v in pairs(hrp:GetChildren()) do
        if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then
            v:Destroy()
        end
    end

    local direction = behindPos - hrp.Position
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
    bv.Velocity = direction * CONFIG.Speed
    bv.Parent = hrp

    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
    bg.CFrame = CFrame.new(hrp.Position, tHrp.Position)
    bg.Parent = hrp

    game.Debris:AddItem(bv, 0.1)
    game.Debris:AddItem(bg, 0.1)

    if CONFIG.ShowDistance then
        statusText.Text = "Đang bám: " .. targetPlayer.DisplayName .. " (" .. math.floor(dist) .. "m)"
    end
end)

-- ==================== PHÍM TẮT ====================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F5 then
        main.Visible = not main.Visible
        if main.Visible then
            updatePlayerList()
        end
    elseif input.KeyCode == Enum.KeyCode.F6 then
        toggleChase()
    end
end)

