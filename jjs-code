local function updateList()
    for _, child in scroll:GetChildren() do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local plrs    = Players:GetPlayers()
    local count   = 0

    for _, plr in ipairs(plrs) do
        if plr ~= player then
            count = count + 1
            local row = Instance.new("TextButton")
            row.Name              = plr.Name
            row.Size              = UDim2.new(1, 0, 0, 32)
            row.BackgroundColor3  = (selectedPlayer == plr) and C.selectedBg or C.card
            row.BorderSizePixel   = 0
            row.Text              = ""
            row.AutoButtonColor   = false
            row.Parent            = scroll
            corner(row, 6)
            if selectedPlayer ~= plr then
                stroke(row, C.border, 1)
            end

            -- Avatar thumbnail (fire and forget)
            local thumb = Instance.new("ImageLabel")
            thumb.Size              = UDim2.new(0, 24, 0, 24)
            thumb.Position          = UDim2.new(0, 6, 0.5, -12)
            thumb.BackgroundColor3  = C.panel
            thumb.BorderSizePixel   = 0
            thumb.Image             = "rbxthumb://type=AvatarHeadShot&id=" .. plr.UserId .. "&w=48&h=48"
            thumb.Parent            = row
            corner(thumb, 4)

            local nameL = label(row, plr.Name, 13, (selectedPlayer == plr) and C.textPrim or C.textSec, true)
            nameL.Size     = UDim2.new(1, -70, 1, 0)
            nameL.Position = UDim2.new(0, 36, 0, 0)

            -- Ping/display-name sub-label
            local dispL = label(row, "@" .. plr.DisplayName, 11, C.textMuted)
            dispL.Size     = UDim2.new(1, -70, 0, 14)
            dispL.Position = UDim2.new(0, 36, 1, -14)

            -- Selected indicator
            if selectedPlayer == plr then
                local dot = Instance.new("Frame")
                dot.Size            = UDim2.new(0, 6, 0, 6)
                dot.Position        = UDim2.new(1, -14, 0.5, -3)
                dot.BackgroundColor3 = C.success
                dot.BorderSizePixel  = 0
                dot.Parent           = row
                corner(dot, 999)
            end

            row.MouseEnter:Connect(function()
                if selectedPlayer ~= plr then tween(row, {BackgroundColor3 = C.border}) end
            end)
            row.MouseLeave:Connect(function()
                if selectedPlayer ~= plr then tween(row, {BackgroundColor3 = C.card}) end
            end)

            row.MouseButton1Click:Connect(function()
                selectedPlayer = plr
                updateList()
                setStatus("Đã chọn: " .. plr.Name, C.success, C.success)
            end)
        end
    end

    if count == 0 then
        local noPlr = label(scroll, "Không có người chơi nào khác", 13, C.textMuted)
        noPlr.Size             = UDim2.new(1, 0, 0, 40)
        noPlr.TextXAlignment   = Enum.TextXAlignment.Center
    end

    scroll.CanvasSize = UDim2.new(0, 0, 0, count * 36 + 8)
end

-- ═══════════════════════════════════════════════
--  FOLLOW  LOGIC  (FIXED)
--  ─────────────────────────────────────────────
--  BUG CŨ: root.CFrame = ... mỗi Heartbeat
--    → server không nhận đúng vị trí → attack/skill trượt hư không
--
--  FIX: Dùng Humanoid:MoveTo() → làm việc đúng với physics, 
--       server nhận vị trí chính xác, attack và skill hoạt động bình thường.
--       Chỉ move khi khoảng cách > threshold để không khoá chuyển động.
-- ═══════════════════════════════════════════════
local function startFollow()
    if followConnection then followConnection:Disconnect() end

    followConnection = RunService.Heartbeat:Connect(function()
        if not isFollowing then return end

        local myChar = player.Character
        if not myChar then return end
        local myRoot    = myChar:FindFirstChild("HumanoidRootPart")
        local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
        if not myRoot or not myHumanoid then return end
        if myHumanoid.Health <= 0 then return end

        local targetChar = selectedPlayer and selectedPlayer.Character
        if not targetChar then return end
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return end

        local targetCF       = targetRoot.CFrame
        local behindPos      = targetCF.Position - (targetCF.LookVector * FOLLOW_DISTANCE)
        local dist           = (myRoot.Position - behindPos).Magnitude

        -- Chỉ move khi xa hơn 1 stud – tránh lock animation khi đứng gần
        if dist > 1.0 then
            -- ✅ FIX: MoveTo() thay vì set CFrame
            myHumanoid:MoveTo(behindPos, targetRoot)
        end
    end)
end

local function stopFollow()
    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end
    local myChar     = player.Character
    local myHumanoid = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if myHumanoid then myHumanoid:Move(Vector3.zero) end  -- stop movement
end

-- ── Toggle function ──────────────────────────────
local function toggleFollow()
    if isFollowing then
        -- Turn OFF
        isFollowing = false
        stopFollow()
        tween(toggleBtn, {BackgroundColor3 = C.accent})
        toggleBtn.Text = "▶  BẮT ĐẦU FOLLOW"
        setStatus("Đã dừng follow", C.textSec, C.textMuted)
    else
        -- Turn ON
        if not selectedPlayer then
            tween(toggleBtn, {BackgroundColor3 = C.warn})
            toggleBtn.Text = "⚠  CHỌN MỤC TIÊU TRƯỚC"
            setStatus("Chưa chọn mục tiêu!", C.warn, C.warn)
            task.delay(1.8, function()
                if not isFollowing then
                    tween(toggleBtn, {BackgroundColor3 = C.accent})
                    toggleBtn.Text = "▶  BẮT ĐẦU FOLLOW"
                    setStatus("Idle — chọn mục tiêu trước", C.textSec, C.textMuted)
                end
            end)
            return
        end
        isFollowing = true
        startFollow()
        tween(toggleBtn, {BackgroundColor3 = C.danger})
        toggleBtn.Text = "⏹  DỪNG FOLLOW"
        setStatus("Đang follow: " .. selectedPlayer.Name, C.danger, C.danger)
    end
end

toggleBtn.MouseButton1Click:Connect(toggleFollow)

