// ==UserScript==
// @name Jujutsu Shenanigans Auto Chase (Manual Attack)
// @description Tự động bám sát sau lưng mục tiêu, đánh và skill thủ công
// @grant none
// ==/UserScript==

(function() {
    'use strict';

    // Biến toàn cục
    let isActive = false;
    let targetPlayer = null;
    let guiElement = null;
    let dragState = {
        isDragging: false,
        startX: 0,
        startY: 0,
        offsetX: 0,
        offsetY: 0
    };

    // Style CSS cho GUI
    const styles = `
        @import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&display=swap');
        
        .jjs-auto-gui * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Quicksand', 'Segoe UI', sans-serif;
        }
        
        .jjs-auto-gui {
            position: fixed;
            top: 50px;
            right: 50px;
            z-index: 999999;
            min-width: 350px;
            background: linear-gradient(135deg, rgba(20, 20, 30, 0.97), rgba(30, 30, 45, 0.97));
            backdrop-filter: blur(20px);
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), 
                        0 0 0 1px rgba(255, 255, 255, 0.1),
                        0 0 30px rgba(138, 43, 226, 0.3);
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid rgba(138, 43, 226, 0.3);
        }
        
        .gui-header {
            padding: 16px 20px;
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.3), rgba(75, 0, 130, 0.2));
            border-bottom: 1px solid rgba(138, 43, 226, 0.3);
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: grab;
            user-select: none;
            -webkit-user-select: none;
            position: relative;
        }
        
        .gui-header:active {
            cursor: grabbing;
        }
        
        .gui-header::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(138, 43, 226, 0.5), transparent);
        }
        
        .gui-title {
            font-size: 16px;
            font-weight: 700;
            color: #fff;
            text-shadow: 0 2px 10px rgba(138, 43, 226, 0.7);
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .gui-title-icon {
            font-size: 22px;
            filter: drop-shadow(0 0 10px rgba(138, 43, 226, 0.7));
        }
        
        .close-btn {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: 1px solid rgba(255, 100, 100, 0.3);
            background: rgba(255, 100, 100, 0.2);
            color: #ff6b6b;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            font-size: 14px;
            font-weight: bold;
        }
        
        .close-btn:hover {
            background: rgba(255, 100, 100, 0.5);
            border-color: rgba(255, 100, 100, 0.6);
            transform: rotate(90deg);
            box-shadow: 0 0 15px rgba(255, 100, 100, 0.4);
        }
        
        .gui-body {
            padding: 20px;
        }
        
        .section-label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(180, 180, 255, 0.8);
            margin-bottom: 8px;
        }
        
        .player-list-container {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            border: 1px solid rgba(138, 43, 226, 0.2);
            overflow: hidden;
            margin-bottom: 15px;
            max-height: 200px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(138, 43, 226, 0.5) transparent;
        }
        
        .player-list-container::-webkit-scrollbar {
            width: 4px;
        }
        
        .player-list-container::-webkit-scrollbar-thumb {
            background: rgba(138, 43, 226, 0.5);
            border-radius: 10px;
        }
        
        .player-item {
            padding: 12px 16px;
            margin: 0;
            cursor: pointer;
            transition: all 0.2s ease;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: rgba(255, 255, 255, 0.7);
            font-size: 13px;
            font-weight: 500;
        }
        
        .player-item:last-child {
            border-bottom: none;
        }
        
        .player-item:hover {
            background: rgba(138, 43, 226, 0.2);
            color: white;
        }
        
        .player-item.selected {
            background: rgba(138, 43, 226, 0.4);
            color: white;
            border-left: 3px solid #8e44ad;
            box-shadow: 0 0 15px rgba(138, 43, 226, 0.3);
        }
        
        .player-name {
            flex: 1;
        }
        
        .player-check {
            opacity: 0;
            transition: all 0.2s ease;
            color: #2ed573;
            font-weight: bold;
        }
        
        .player-item.selected .player-check {
            opacity: 1;
        }
        
        .empty-list {
            padding: 20px;
            text-align: center;
            color: rgba(255, 255, 255, 0.4);
            font-size: 12px;
        }
        
        .refresh-btn {
            width: 100%;
            padding: 8px;
            margin-top: 8px;
            background: rgba(138, 43, 226, 0.2);
            border: 1px solid rgba(138, 43, 226, 0.3);
            border-radius: 8px;
            color: rgba(255, 255, 255, 0.7);
            font-size: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
        }
        
        .refresh-btn:hover {
            background: rgba(138, 43, 226, 0.4);
            color: white;
        }
        
        .selected-info {
            padding: 12px;
            background: rgba(138, 43, 226, 0.15);
            border-radius: 10px;
            border: 1px solid rgba(138, 43, 226, 0.2);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .selected-info .label {
            font-size: 11px;
            color: rgba(180, 180, 255, 0.6);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .selected-info .value {
            font-size: 14px;
            color: white;
            font-weight: 600;
            flex: 1;
        }
        
        .status-section {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
            padding: 12px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .status-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #ff4757;
            box-shadow: 0 0 10px rgba(255, 71, 87, 0.5);
            transition: all 0.3s ease;
            flex-shrink: 0;
        }
        
        .status-dot.active {
            background: #2ed573;
            box-shadow: 0 0 15px rgba(46, 213, 115, 0.7);
            animation: jjsGlow 1.5s infinite;
        }
        
        @keyframes jjsGlow {
            0%, 100% { box-shadow: 0 0 10px rgba(46, 213, 115, 0.5); }
            50% { box-shadow: 0 0 25px rgba(46, 213, 115, 0.9); }
        }
        
        .status-text {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.8);
            font-weight: 500;
            flex: 1;
        }
        
        .toggle-btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 2px;
            position: relative;
            overflow: hidden;
            margin-top: 5px;
        }
        
        .toggle-btn::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent);
            transform: rotate(45deg);
            transition: all 0.5s ease;
        }
        
        .toggle-btn:hover::after {
            left: 50%;
        }
        
        .toggle-btn.off {
            background: linear-gradient(135deg, #6c3483, #8e44ad);
            color: white;
            box-shadow: 0 5px 20px rgba(138, 43, 226, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .toggle-btn.on {
            background: linear-gradient(135deg, #2ed573, #8e44ad);
            color: white;
            box-shadow: 0 5px 20px rgba(46, 213, 115, 0.4);
            animation: buttonGlow 2s infinite;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        
        @keyframes buttonGlow {
            0%, 100% { box-shadow: 0 5px 20px rgba(46, 213, 115, 0.4); }
            50% { box-shadow: 0 5px 30px rgba(46, 213, 115, 0.7), 0 0 40px rgba(138, 43, 226, 0.3); }
        }
        
        .toggle-btn:hover {
            transform: translateY(-2px);
        }
        
        .toggle-btn:active {
            transform: translateY(0);
        }
        
        .toggle-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }
        
        .info-text {
            margin-top: 12px;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.4);
            text-align: center;
            font-weight: 500;
        }
    `;

    // Inject styles
    function injectStyles() {
        const styleElement = document.createElement('style');
        styleElement.textContent = styles;
        document.head.appendChild(styleElement);
    }

    // Tạo GUI
    function createGUI() {
        guiElement = document.createElement('div');
        guiElement.className = 'jjs-auto-gui';
        guiElement.innerHTML = `
            <div class="gui-header" id="gui-drag-handle">
                <div class="gui-title">
                    <span class="gui-title-icon">👁️</span>
                    Six Eyes Chase
                </div>
                <button class="close-btn" id="gui-close-btn">✕</button>
            </div>
            <div class="gui-body">
                <div class="selected-info">
                    <span class="label">🎯 Mục tiêu:</span>
                    <span class="value" id="selected-target-display">Chưa chọn</span>
                </div>
                
                <label class="section-label">📋 Danh sách người chơi</label>
                <div class="player-list-container" id="player-list">
                    <div class="empty-list">Đang tải danh sách...</div>
                </div>
                
                <button class="refresh-btn" id="refresh-players-btn">
                    🔄 Làm mới danh sách
                </button>
                
                <div class="status-section" style="margin-top: 15px;">
                    <div class="status-dot" id="status-dot"></div>
                    <span class="status-text" id="status-text">Chưa kích hoạt</span>
                </div>
                
                <button class="toggle-btn off" id="toggle-btn" disabled>
                    ▶ KÍCH HOẠT
                </button>
                
                <div class="info-text">
                    F5 để mở/đóng | Kéo thả để di chuyển | Đánh & Skill thủ công
                </div>
            </div>
        `;

        document.body.appendChild(guiElement);
        setupEventListeners();
        setupDragFunctionality();
        updatePlayerList();
        
        // Auto refresh mỗi 5 giây
        setInterval(() => {
            if (guiElement.style.display !== 'none') {
                updatePlayerList();
            }
        }, 5000);
    }

    // Kéo thả GUI
    function setupDragFunctionality() {
        const header = document.getElementById('gui-drag-handle');
        
        header.addEventListener('mousedown', (e) => {
            if (e.target.tagName === 'BUTTON') return;
            
            dragState.isDragging = true;
            const rect = guiElement.getBoundingClientRect();
            dragState.offsetX = e.clientX - rect.left;
            dragState.offsetY = e.clientY - rect.top;
            
            guiElement.style.transition = 'none';
            e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
            if (!dragState.isDragging) return;
            
            const newX = e.clientX - dragState.offsetX;
            const newY = e.clientY - dragState.offsetY;
            
            const maxX = window.innerWidth - guiElement.offsetWidth;
            const maxY = window.innerHeight - guiElement.offsetHeight;
            
            guiElement.style.right = 'auto';
            guiElement.style.top = 'auto';
            guiElement.style.left = Math.max(0, Math.min(newX, maxX)) + 'px';
            guiElement.style.top = Math.max(0, Math.min(newY, maxY)) + 'px';
        });

        document.addEventListener('mouseup', () => {
            if (dragState.isDragging) {
                dragState.isDragging = false;
                guiElement.style.transition = 'all 0.3s ease';
            }
        });
    }

    // Event listeners
    function setupEventListeners() {
        // Nút đóng
        document.getElementById('gui-close-btn').addEventListener('click', () => {
            guiElement.style.display = 'none';
        });

        // Nút toggle ON/OFF
        document.getElementById('toggle-btn').addEventListener('click', toggleAutoChase);
        
        // Nút refresh
        document.getElementById('refresh-players-btn').addEventListener('click', updatePlayerList);

        // Phím tắt F5
        document.addEventListener('keydown', (e) => {
            if (e.key === 'F5') {
                e.preventDefault();
                if (guiElement.style.display === 'none') {
                    guiElement.style.display = 'block';
                    updatePlayerList();
                } else {
                    guiElement.style.display = 'none';
                }
            }
        });
    }

    // Lấy danh sách players
    function getAllPlayers() {
        try {
            const players = game.Players.GetPlayers();
            const localPlayer = game.Players.LocalPlayer;
            return players
                .filter(p => p !== localPlayer)
                .map(p => ({
                    name: p.Name,
                    displayName: p.DisplayName || p.Name,
                    player: p
                }));
        } catch (e) {
            console.error('Lỗi lấy danh sách players:', e);
            return [];
        }
    }

    // Cập nhật danh sách player
    function updatePlayerList() {
        const listContainer = document.getElementById('player-list');
        const players = getAllPlayers();
        const currentTarget = document.getElementById('selected-target-display').textContent;
        
        listContainer.innerHTML = '';
        
        if (players.length === 0) {
            listContainer.innerHTML = '<div class="empty-list">Không có người chơi nào khác</div>';
            return;
        }
        
        players.forEach(({name, displayName}) => {
            const item = document.createElement('div');
            item.className = 'player-item';
            item.innerHTML = `
                <span class="player-name">${displayName}</span>
                <span class="player-check">✓</span>
            `;
            
            // Highlight player đang được chọn
            if (name === currentTarget) {
                item.classList.add('selected');
            }
            
            item.addEventListener('click', () => {
                selectPlayer(name, displayName);
            });
            
            listContainer.appendChild(item);
        });
    }

    // Chọn player
    function selectPlayer(name, displayName) {
        // Update display
        document.getElementById('selected-target-display').textContent = name;
        
        // Update danh sách highlight
        document.querySelectorAll('.player-item').forEach(item => {
            item.classList.remove('selected');
            if (item.querySelector('.player-name').textContent === displayName) {
                item.classList.add('selected');
            }
        });
        
        // Enable nút toggle
        document.getElementById('toggle-btn').disabled = false;
        
        // Nếu đang chạy, cập nhật target mới
        if (isActive) {
            const targetPlayerObj = game.Players.FindFirstChild(name);
            if (targetPlayerObj && targetPlayerObj.Character) {
                targetPlayer = targetPlayerObj;
                showNotification(`Đã chuyển mục tiêu sang: ${displayName}`);
            } else {
                showNotification('Người chơi chưa spawn hoặc đã thoát!');
            }
        }
    }

    // Toggle auto chase
    function toggleAutoChase() {
        const btn = document.getElementById('toggle-btn');
        const dot = document.getElementById('status-dot');
        const statusText = document.getElementById('status-text');
        const targetName = document.getElementById('selected-target-display').textContent;

        if (!isActive) {
            if (targetName === 'Chưa chọn') {
                showNotification('Vui lòng chọn mục tiêu từ danh sách!');
                return;
            }

            // Tìm player
            const targetPlayerObj = game.Players.FindFirstChild(targetName);
            if (!targetPlayerObj) {
                showNotification('Không tìm thấy người chơi này!');
                return;
            }
            
            if (!targetPlayerObj.Character) {
                showNotification('Người chơi chưa spawn! Đợi họ spawn rồi thử lại.');
                return;
            }

            targetPlayer = targetPlayerObj;
            isActive = true;
            
            btn.textContent = '⏸ TẮT';
            btn.className = 'toggle-btn on';
            dot.className = 'status-dot active';
            statusText.textContent = `Đang bám sát: ${targetPlayer.DisplayName || targetPlayer.Name}`;
            
            showNotification(`Bắt đầu bám sát ${targetPlayer.DisplayName || targetPlayer.Name}! Đánh và skill thủ công.`);
            startChaseLoop();
        } else {
            isActive = false;
            targetPlayer = null;
            
            btn.textContent = '▶ KÍCH HOẠT';
            btn.className = 'toggle-btn off';
            dot.className = 'status-dot';
            statusText.textContent = 'Đã dừng';
            
            showNotification('Đã dừng bám sát!');
        }
    }

    // Main chase loop - CHỈ di chuyển, KHÔNG đánh
    function startChaseLoop() {
        if (!isActive || !targetPlayer) return;

        try {
            const localPlayer = game.Players.LocalPlayer;
            const character = localPlayer.Character;
            const targetCharacter = targetPlayer.Character;

            if (!character || !targetCharacter) {
                if (!targetCharacter) {
                    statusText.textContent = 'Mục tiêu đã thoát hoặc chưa spawn!';
                    // Đợi target respawn
                    waitForTargetRespawn();
                    return;
                }
                return;
            }

            const humanoid = character.FindFirstChildOfClass('Humanoid');
            const targetHumanoid = targetCharacter.FindFirstChildOfClass('Humanoid');
            const humanoidRootPart = character.FindFirstChild('HumanoidRootPart');
            const targetRootPart = targetCharacter.FindFirstChild('HumanoidRootPart');

            if (!humanoid || !targetHumanoid || !humanoidRootPart || !targetRootPart) return;

            // Kiểm tra health
            if (humanoid.Health <= 0) {
                document.getElementById('status-text').textContent = 'Bạn đã chết! Đợi respawn...';
                waitForRespawn();
                return;
            }

            if (targetHumanoid.Health <= 0) {
                document.getElementById('status-text').textContent = 'Mục tiêu đã chết! Đợi respawn...';
                waitForTargetRespawn();
                return;
            }

            // Tính toán vị trí đứng sau lưng target
            const distance = 5; // Khoảng cách 5 studs
            const lookVector = targetRootPart.CFrame.LookVector;
            
            const behindPosition = new Vector3(
                targetRootPart.Position.X - lookVector.X * distance,
                targetRootPart.Position.Y,
                targetRootPart.Position.Z - lookVector.Z * distance
            );

            // Di chuyển ra sau target
            humanoid:MoveTo(behindPosition);
            
            // Xoay mặt nhìn vào target
            humanoidRootPart.CFrame = CFrame.new(
                humanoidRootPart.Position,
                targetRootPart.Position
            );

            // Cập nhật status
            const dist = Math.floor((humanoidRootPart.Position - targetRootPart.Position).Magnitude);
            document.getElementById('status-text').textContent = 
                `Đang bám sát: ${targetPlayer.DisplayName || targetPlayer.Name} (${dist}m)`;

        } catch (e) {
            console.error('Lỗi trong chase loop:', e);
        }

        // Lặp lại
        if (isActive) {
            requestAnimationFrame(startChaseLoop);
        }
    }

    // Chờ target respawn
    function waitForTargetRespawn() {
        if (!targetPlayer || !isActive) return;
        
        const checkInterval = setInterval(() => {
            if (!isActive || !targetPlayer) {
                clearInterval(checkInterval);
                return;
            }
            
            const targetCharacter = targetPlayer.Character;
            if (targetCharacter && targetCharacter.FindFirstChildOfClass('Humanoid') && 
                targetCharacter.FindFirstChildOfClass('Humanoid').Health > 0) {
                clearInterval(checkInterval);
                document.getElementById('status-text').textContent = 
                    `Đang bám sát: ${targetPlayer.DisplayName || targetPlayer.Name}`;
                showNotification('Mục tiêu đã respawn! Tiếp tục bám sát.');
            }
        }, 1000);
    }

    // Chờ bản thân respawn
    function waitForRespawn() {
        const localPlayer = game.Players.LocalPlayer;
        
        const checkInterval = setInterval(() => {
            if (!isActive) {
                clearInterval(checkInterval);
                return;
            }
            
            const character = localPlayer.Character;
            if (character && character.FindFirstChildOfClass('Humanoid') && 
                character.FindFirstChildOfClass('Humanoid').Health > 0) {
                clearInterval(checkInterval);
                document.getElementById('status-text').textContent = 
                    `Đang bám sát: ${targetPlayer.DisplayName || targetPlayer.Name}`;
                showNotification('Đã respawn! Tiếp tục bám sát.');
            }
        }, 1000);
    }

    // Hiển thị thông báo
    function showNotification(message) {
        const notification = document.createElement('div');
        notification.style.cssText = `
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(138, 43, 226, 0.95);
            color: white;
            padding: 12px 24px;
            border-radius: 25px;
            font-family: 'Quicksand', sans-serif;
            font-weight: 600;
            font-size: 14px;
            z-index: 9999999;
            box-shadow: 0 10px 30px rgba(138, 43, 226, 0.5);
            animation: slideDown 0.3s ease, fadeOut 0.3s ease 1.7s forwards;
            pointer-events: none;
        `;
        notification.textContent = message;
        document.body.appendChild(notification);
        
        setTimeout(() => {
            if (notification.parentNode) {
                notification.parentNode.removeChild(notification);
            }
        }, 2000);
    }

    // Thêm animation styles
    function addAnimationStyles() {
        const animStyles = document.createElement('style');
        animStyles.textContent = `
            @keyframes slideDown {
                from { transform: translateX(-50%) translateY(-100px); opacity: 0; }
                to { transform: translateX(-50%) translateY(0); opacity: 1; }
            }
            @keyframes fadeOut {
                from { opacity: 1; }
                to { opacity: 0; }
            }
        `;
        document.head.appendChild(animStyles);
    }

    // Khởi tạo
    async function init() {
        injectStyles();
        addAnimationStyles();
        await waitForGame();
        createGUI();
        console.log('Jujutsu Shenanigans Auto Chase đã sẵn sàng!');
        console.log('- F5: Mở/đóng GUI');
        console.log('- Chọn mục tiêu từ danh sách');
        console.log('- Nhấn KÍCH HOẠT để bắt đầu bám sát');
        console.log('- Đánh và skill là THỦ CÔNG (bạn tự bấm)');
    }

    // Chạy
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

})();
