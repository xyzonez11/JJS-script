--[[
    Script: JJS Hub - Follow Player
    Description: A hub with GUI on the left side, toggle with F5.
]]

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

-- Variables
local player = Players.LocalPlayer
local character = player.Character
local rootPart = character and character:FindFirstChild("HumanoidRootPart")

local selectedPlayer = nil
local isFollowing = false
local followConnection = nil
local isHubOpen = false

-- UI Elements
local screenGui = nil
local mainFrame = nil
local featuresFrame = nil
local playerDropdown = nil
local toggleButton = nil

-- Function to create the GUI
local function createGUI()
    -- Create ScreenGui
    screenGui = Instance.new("ScreenGui")
    screenGui.Name = "JJS_Hub"
    screenGui.Parent = player.PlayerGui
    screenGui.Enabled = false -- Start closed

    -- Main Frame (Hub) - Left side
    mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainFrame"
    mainFrame.Size = UDim2.new(0, 250, 1, 0) -- Full height, 250 width
    mainFrame.Position = UDim2.new(0, 0, 0, 0) -- Left side
    mainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    mainFrame.BackgroundTransparency = 0.05
    mainFrame.BorderSizePixel = 0
    mainFrame.ClipsDescendants = true
    mainFrame.Parent = screenGui

    -- Top bar (Title + Close button)
    local topBar = Instance.new("Frame")
    topBar.Name = "TopBar"
    topBar.Size = UDim2.new(1, 0, 0, 45)
    topBar.Position = UDim2.new(0, 0, 0, 0)
    topBar.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    topBar.BorderSizePixel = 0
    topBar.Parent = mainFrame

    -- Title
    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Size = UDim2.new(1, -40, 1, 0)
    title.Position = UDim2.new(0, 5, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = "JJS HUB"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 20
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.GothamBold
    title.Parent = topBar

    -- Close Button (X)
    local closeButton = Instance.new("TextButton")
    closeButton.Name = "CloseButton"
    closeButton.Size = UDim2.new(0, 35, 1, 0)
    closeButton.Position = UDim2.new(1, -35, 0, 0)
    closeButton.BackgroundTransparency = 1
    closeButton.Text = "✕"
    closeButton.TextColor3 = Color3.fromRGB(255, 100, 100)
    closeButton.TextSize = 22
    closeButton.Font = Enum.Font.GothamBold
    closeButton.Parent = topBar
    closeButton.MouseButton1Click:Connect(function()
        isHubOpen = false
        screenGui.Enabled = false
    end)

    -- Features Container (ScrollingFrame for future features)
    featuresFrame = Instance.new("ScrollingFrame")
    featuresFrame.Name = "FeaturesFrame"
    featuresFrame.Size = UDim2.new(1, -20, 1, -55)
    featuresFrame.Position = UDim2.new(0, 10, 0, 50)
    featuresFrame.BackgroundTransparency = 1
    featuresFrame.BorderSizePixel = 0
    featuresFrame.ScrollBarThickness = 4
    featuresFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    featuresFrame.Parent = mainFrame

    -- Feature 1: Follow Player
    local feature1Frame = Instance.new("Frame")
    feature1Frame.Name = "Feature1"
    feature1Frame.Size = UDim2.new(1, 0, 0, 120)
    feature1Frame.Position = UDim2.new(0, 0, 0, 0)
    feature1Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    feature1Frame.BackgroundTransparency = 0.3
    feature1Frame.BorderSizePixel = 0
    feature1Frame.Parent = featuresFrame

    -- Feature Title
    local featureTitle = Instance.new("TextLabel")
    featureTitle.Name = "FeatureTitle"
    featureTitle.Size = UDim2.new(1, -10, 0, 25)
    featureTitle.Position = UDim2.new(0, 5, 0, 5)
    featureTitle.BackgroundTransparency = 1
    featureTitle.Text = "📌 Follow Player"
    featureTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    featureTitle.TextSize = 16
    featureTitle.TextXAlignment = Enum.TextXAlignment.Left
    featureTitle.Font = Enum.Font.GothamBold
    featureTitle.Parent = feature1Frame

    -- Player Dropdown Label
    local dropdownLabel = Instance.new("TextLabel")
    dropdownLabel.Name = "DropdownLabel"
    dropdownLabel.Size = UDim2.new(0, 80, 0, 25)
    dropdownLabel.Position = UDim2.new(0, 5, 0, 35)
    dropdownLabel.BackgroundTransparency = 1
    dropdownLabel.Text = "Player:"
    dropdownLabel.TextColor3 = Color3.fromRGB(180, 180, 200)
    dropdownLabel.TextSize = 14
    dropdownLabel.TextXAlignment = Enum.TextXAlignment.Left
    dropdownLabel.Font = Enum.Font.Gotham
    dropdownLabel.Parent = feature1Frame

    -- Player Dropdown (ScrollingFrame)
    local dropdownFrame = Instance.new("ScrollingFrame")
    dropdownFrame.Name = "DropdownFrame"
    dropdownFrame.Size = UDim2.new(0, 140, 0, 45)
    dropdownFrame.Position = UDim2.new(0, 90, 0, 35)
    dropdownFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    dropdownFrame.BorderSizePixel = 0
    dropdownFrame.ScrollBarThickness = 4
    dropdownFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    dropdownFrame.Parent = feature1Frame

    -- Populate dropdown with players
    local function updateDropdown()
        -- Clear existing buttons
        for _, child in ipairs(dropdownFrame:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        local players = Players:GetPlayers()
        local yOffset = 0
        for _, plr in ipairs(players) do
            if plr ~= player then
                local btn = Instance.new("TextButton")
                btn.Name = plr.Name
                btn.Size = UDim2.new(1, 0, 0, 22)
                btn.Position = UDim2.new(0, 0, 0, yOffset)
                btn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
                btn.BorderSizePixel = 0
                btn.Text = plr.Name
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                btn.TextSize = 12
                btn.Font = Enum.Font.Gotham
                btn.Parent = dropdownFrame

                btn.MouseButton1Click:Connect(function()
                    selectedPlayer = plr
                    -- Highlight selected
                    for _, child in ipairs(dropdownFrame:GetChildren()) do
                        if child:IsA("TextButton") then
                            child.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
                        end
                    end
                    btn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
                end)

                yOffset = yOffset + 25
            end
        end
        dropdownFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset + 5)
    end

    updateDropdown()

    -- Toggle Button (On/Off)
    toggleButton = Instance.new("TextButton")
    toggleButton.Name = "ToggleButton"
    toggleButton.Size = UDim2.new(0, 60, 0, 30)
    toggleButton.Position = UDim2.new(0, 5, 0, 85)
    toggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
    toggleButton.BorderSizePixel = 0
    toggleButton.Text = "OFF"
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.TextSize = 14
    toggleButton.Font = Enum.Font.GothamBold
    toggleButton.Parent = feature1Frame

    toggleButton.MouseButton1Click:Connect(function()
        if isFollowing then
            -- Turn off
            isFollowing = false
            toggleButton.Text = "OFF"
            toggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            if followConnection then
                followConnection:Disconnect()
                followConnection = nil
            end
        else
            -- Turn on
            if selectedPlayer then
                isFollowing = true
                toggleButton.Text = "ON"
                toggleButton.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
                -- Start following
                if followConnection then
                    followConnection:Disconnect()
                end
                followConnection = RunService.Heartbeat:Connect(function()
                    local targetChar = selectedPlayer.Character
                    if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                        local targetRoot = targetChar.HumanoidRootPart
                        local character = player.Character
                        if character and character:FindFirstChild("HumanoidRootPart") then
                            local root = character.HumanoidRootPart
                            local targetCFrame = targetRoot.CFrame
                            -- Changed from 5 to 2.5 to be closer for melee attacks
                            local behindPosition = targetCFrame.Position - (targetCFrame.LookVector * 2.5) + Vector3.new(0, 1.5, 0)
                            root.CFrame = CFrame.new(behindPosition, targetCFrame.Position)
                        end
                    end
                end)
            else
                -- No player selected
                toggleButton.Text = "No Player!"
                toggleButton.BackgroundColor3 = Color3.fromRGB(255, 165, 0)
                task.wait(1)
                toggleButton.Text = "OFF"
                toggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            end
        end
    end)

    -- Update dropdown when players join/leave
    Players.PlayerAdded:Connect(updateDropdown)
    Players.PlayerRemoving:Connect(updateDropdown)

    -- Update canvas size for features frame
    featuresFrame.CanvasSize = UDim2.new(0, 0, 0, 130) -- Add more height for future features

    return screenGui
end

-- Toggle hub with F5
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F5 then
        if screenGui then
            isHubOpen = not isHubOpen
            screenGui.Enabled = isHubOpen
        else
            createGUI()
            isHubOpen = true
            screenGui.Enabled = true
        end
    end
end)

-- Create GUI initially but keep it closed
createGUI()

-- Print instructions
print("JJS Hub loaded!")
print("Press F5 to open/close the hub.")
print("Select a player from the dropdown, then click the toggle button to fly behind them.")

-- Cleanup function
local function cleanup()
    if followConnection then
        followConnection:Disconnect()
        followConnection = nil
    end
    if screenGui then
        screenGui:Destroy()
        screenGui = nil
    end
end

-- Handle player respawn
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    rootPart = character and character:FindFirstChild("HumanoidRootPart")
end)

-- If character is nil, wait for it
if not character then
    player.CharacterAdded:Wait()
    character = player.Character
    rootPart = character and character:FindFirstChild("HumanoidRootPart")
end
