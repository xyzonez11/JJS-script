// ==UserScript==
// @name Jujutsu Shenanigans Auto Chase
// @description Bám sát sau lưng mục tiêu, đánh và skill thủ công
// @grant none
// ==/UserScript==

(function() {
    'use strict';

    let isActive = false;
    let targetPlayer = null;
    let guiElement = null;
    let isDragging = false;
    let dragOffsetX = 0;
    let dragOffsetY = 0;

    // Chờ game load
    function waitForGame() {
        return new Promise((resolve) => {
            const check = () => {
                if (typeof game !== 'undefined' && game.Players && game.Players.LocalPlayer) {
                    resolve();
                } else {
                    setTimeout(check, 500);
                }
            };
            check();
        });
    }

    // Style CSS
    const styles = `
        .jjs-gui * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', sans-serif;
        }
        
        .jjs-gui {
            position: fixed;
            top: 50px;
            right: 50px;
            z-index: 999999;
            width: 320px;
            background: rgba(20, 20, 30, 0.95);
            backdrop-filter: blur(15px);
            border-radius: 12px;
            border: 1px solid rgba(138, 43, 226, 0.4);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
            overflow: hidden;
            display: none;
        }
        
        .jjs-header {
            padding: 14px 18px;
            background: rgba(138, 43, 226, 0.3);
            border-bottom: 1px solid rgba(138, 43, 226, 0.3);
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: grab;
            user-select: none;
        }
        
        .jjs-header:active {
            cursor: grabbing;
        }
        
        .jjs-title {
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            letter-spacing: 0.5px;
        }
        
        .jjs-close {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: none;
            background: rgba(255, 80, 80, 0.3);
            color: #ff5050;
            cursor: pointer;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.2s;
        }
        
        .jjs-close:hover {
            background: rgba(255, 80, 80, 0.6);
            transform: rotate(90deg);
        }
        
        .jjs-body {
            padding: 16px;
        }
        
        .jjs-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(200, 200, 255, 0.7);
            margin-bottom: 8px;
            display: block;
        }
        
        .jjs-selected {
            padding: 10px 14px;
            background: rgba(138, 43, 226, 0.2);
            border-radius: 8px;
            border: 1px solid rgba(138, 43, 226, 0.3);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            color: #fff;
            font-size: 13px;
            font-weight: 500;
        }
        
        .jjs-list {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            max-height: 180px;
            overflow-y: auto;
            margin-bottom: 8px;
        }
        
        .jjs-list::-webkit-scrollbar {
            width: 4px;
        }
        
        .jjs-list::-webkit-scrollbar-thumb {
            background: rgba(138, 43, 226, 0.5);
            border-radius: 10px;
        }
        
        .jjs-player {
            padding: 10px 14px;
            cursor: pointer;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            color: rgba(255, 255, 255, 0.7);
            font-size: 13px;
            transition: 0.2s;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .jjs-player:hover {
            background: rgba(138, 43, 226, 0.2);
            color: #fff;
        }
        
        .jjs-player.selected {
            background: rgba(138, 43, 226, 0.4);
            color: #fff;
            border-left: 3px solid #9b59b6;
        }
        
        .jjs-check {
            color: #2ecc71;
            font-weight: bold;
            display: none;
        }
        
        .jjs-player.selected .jjs-check {
            display: block;
        }
        
        .jjs-refresh {
            width: 100%;
            padding: 8px;
            background: rgba(138, 43, 226, 0.2);
            border: 1px solid rgba(138, 43, 226, 0.3);
            border-radius: 6px;
            color: rgba(255, 255, 255, 0.8);
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 12px;
            transition: 0.2s;
        }
        
        .jjs-refresh:hover {
            background: rgba(138, 43, 226, 0.4);
        }
        
        .jjs-status {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 8px;
            margin-bottom: 12px;
        }
        
        .jjs-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #e74c3c;
            flex-shrink: 0;
        }
        
        .jjs-dot.active {
            background: #2ecc71;
            box-shadow: 0 0 10px rgba(46, 204, 113, 0.7);
        }
        
        .jjs-status-text {
            font-size: 12px;
            color: rgba(255, 255, 255, 0.8);
            flex: 1;
        }
        
        .jjs-toggle {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: 0.2s;
            color: #fff;
        }
        
        .jjs-toggle.off {
            background: linear-gradient(135deg, #6c3483, #8e44ad);
        }
        
        .jjs-toggle.on {
            background: linear-gradient(135deg, #2ecc71, #8e44ad);
        }
        
        .jjs-toggle:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        .jjs-toggle:not(:disabled):hover {
            transform: translateY(-1px);
        }
        
        .jjs-info {
            text-align: center;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.4);
            margin-top: 10px;
        }
        
        .jjs-empty {
            padding: 20px;
            text-align: center;
            color: rgba(255, 255, 255, 0.4);
            font-size: 12px;
        }
        
        .jjs-notif {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(138, 43, 226, 0.95);
            color: #fff;
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            z-index: 9999999;
            pointer-events: none;
            animation: jjsSlideDown 0.3s ease, jjsFadeOut 0.3s ease 1.7s forwards;
        }
        
        @keyframes jjsSlideDown {
            from { transform: translateX(-50%) translateY(-50px); opacity: 0; }
            to { transform: translateX(-50%) translateY(0); opacity: 1; }
        }
        
        @keyframes jjsFadeOut {
            from { opacity: 1; }
            to { opacity: 0; }
        }
    `;

    function injectStyles() {
        const style = document.createElement('style');
        style.textContent = styles;
        document.head.appendChild(style);
    }

    function notify(msg) {
        const n = document.createElement('div');
        n.className = 'jjs-notif';
        n.textContent = msg;
        document.body.appendChild(n);
        setTimeout(() => n.remove(), 2000);
    }

    function getAllPlayers() {
        try {
            const all = game.Players.GetPlayers();
            const local = game.Players.LocalPlayer;
            return all.filter(p => p !== local).map(p => ({
                name: p.Name,
                display: p.DisplayName || p.Name,
                player: p
            }));
        } catch(e) {
            return [];
        }
    }

    function updateList() {
        const list = document.getElementById('jjs-list');
        const players = getAllPlayers();
        const currentTarget = document.getElementById('jjs-selected-name').textContent;
        
        list.innerHTML = '';
        
        if (players.length === 0) {
            list.innerHTML = '<div class="jjs-empty">Không có người chơi nào</div>';
            return;
        }
        
        players.forEach(({name, display}) => {
            const div = document.createElement('div');
            div.className = 'jjs-player';
            div.innerHTML = `<span>${display}</span><span class="jjs-check">✓</span>`;
            
            if (name === currentTarget) {
                div.classList.add('selected');
            }
            
            div.addEventListener('click', () => selectPlayer(name, display));
            list.appendChild(div);
        });
    }

    function selectPlayer(name, display) {
        document.getElementById('jjs-selected-name').textContent = name;
        document.getElementById('jjs-toggle').disabled = false;
        
        document.querySelectorAll('.jjs-player').forEach(el => {
            el.classList.remove('selected');
            if (el.querySelector('span').textContent === display) {
                el.classList.add('selected');
            }
        });
        
        if (isActive) {
            const tp = game.Players.FindFirstChild(name);
            if (tp && tp.Character) {
                targetPlayer = tp;
                notify(`Đã chuyển mục tiêu: ${display}`);
            } else {
                notify('Người chơi chưa spawn!');
            }
        }
    }

    function toggle() {
        const btn = document.getElementById('jjs-toggle');
        const dot = document.getElementById('jjs-dot');
        const statusText = document.getElementById('jjs-status-text');
        const targetName = document.getElementById('jjs-selected-name').textContent;

        if (!isActive) {
            if (targetName === 'Chưa chọn') {
                notify('Vui lòng chọn mục tiêu!');
                return;
            }

            const tp = game.Players.FindFirstChild(targetName);
            if (!tp) {
                notify('Không tìm thấy người chơi!');
                return;
            }
            if (!tp.Character) {
                notify('Người chơi chưa spawn!');
                return;
            }

            targetPlayer = tp;
            isActive = true;
            
            btn.textContent = '⏸ TẮT';
            btn.className = 'jjs-toggle on';
            dot.className = 'jjs-dot active';
            statusText.textContent = `Đang bám: ${targetPlayer.DisplayName || targetPlayer.Name}`;
            
            notify(`Bắt đầu bám sát ${targetPlayer.DisplayName || targetPlayer.Name}`);
            chaseLoop();
        } else {
            isActive = false;
            targetPlayer = null;
            
            btn.textContent = '▶ KÍCH HOẠT';
            btn.className = 'jjs-toggle off';
            dot.className = 'jjs-dot';
            statusText.textContent = 'Đã dừng';
            
            notify('Đã dừng bám sát');
        }
    }

    function chaseLoop() {
        if (!isActive || !targetPlayer) return;

        try {
            const lp = game.Players.LocalPlayer;
            const char = lp.Character;
            const tChar = targetPlayer.Character;

            if (!char || !tChar) {
                if (!tChar) {
                    document.getElementById('jjs-status-text').textContent = 'Chờ mục tiêu spawn...';
                    waitTargetSpawn();
                    return;
                }
                requestAnimationFrame(chaseLoop);
                return;
            }

            const hum = char.FindFirstChildOfClass('Humanoid');
            const tHum = tChar.FindFirstChildOfClass('Humanoid');
            const hrp = char.FindFirstChild('HumanoidRootPart');
            const tHrp = tChar.FindFirstChild('HumanoidRootPart');

            if (!hum || !tHum || !hrp || !tHrp) {
                requestAnimationFrame(chaseLoop);
                return;
            }

            if (hum.Health <= 0) {
                document.getElementById('jjs-status-text').textContent = 'Bạn đã chết...';
                waitRespawn();
                return;
            }

            if (tHum.Health <= 0) {
                document.getElementById('jjs-status-text').textContent = 'Mục tiêu đã chết...';
                waitTargetSpawn();
                return;
            }

            // Tính vị trí sau lưng
            const dist = 5;
            const lv = tHrp.CFrame.LookVector;
            const behind = new Vector3(
                tHrp.Position.X - lv.X * dist,
                tHrp.Position.Y,
                tHrp.Position.Z - lv.Z * dist
            );

            hum:MoveTo(behind);
            hrp.CFrame = CFrame.new(hrp.Position, tHrp.Position);

            const d = Math.floor((hrp.Position - tHrp.Position).Magnitude);
            document.getElementById('jjs-status-text').textContent = 
                `Đang bám: ${targetPlayer.DisplayName || targetPlayer.Name} (${d}m)`;

        } catch(e) {}

        if (isActive) requestAnimationFrame(chaseLoop);
    }

    function waitTargetSpawn() {
        if (!targetPlayer || !isActive) return;
        const check = setInterval(() => {
            if (!isActive || !targetPlayer) { clearInterval(check); return; }
            if (targetPlayer.Character && targetPlayer.Character.FindFirstChildOfClass('Humanoid') && 
                targetPlayer.Character.FindFirstChildOfClass('Humanoid').Health > 0) {
                clearInterval(check);
                document.getElementById('jjs-status-text').textContent = 
                    `Đang bám: ${targetPlayer.DisplayName || targetPlayer.Name}`;
                notify('Mục tiêu đã spawn!');
            }
        }, 1000);
    }

    function waitRespawn() {
        const lp = game.Players.LocalPlayer;
        const check = setInterval(() => {
            if (!isActive) { clearInterval(check); return; }
            if (lp.Character && lp.Character.FindFirstChildOfClass('Humanoid') && 
                lp.Character.FindFirstChildOfClass('Humanoid').Health > 0) {
                clearInterval(check);
                document.getElementById('jjs-status-text').textContent = 
                    `Đang bám: ${targetPlayer.DisplayName || targetPlayer.Name}`;
                notify('Đã spawn!');
            }
        }, 1000);
    }

    function createGUI() {
        guiElement = document.createElement('div');
        guiElement.className = 'jjs-gui';
        guiElement.id = 'jjs-gui';
        guiElement.innerHTML = `
            <div class="jjs-header" id="jjs-header">
                <span class="jjs-title">👁️ Chase GUI</span>
                <button class="jjs-close" id="jjs-close">✕</button>
            </div>
            <div class="jjs-body">
                <span class="jjs-label">🎯 Mục tiêu hiện tại</span>
                <div class="jjs-selected">
                    <span id="jjs-selected-name">Chưa chọn</span>
                </div>
                
                <span class="jjs-label">📋 Danh sách người chơi</span>
                <div class="jjs-list" id="jjs-list">
                    <div class="jjs-empty">Đang tải...</div>
                </div>
                
                <button class="jjs-refresh" id="jjs-refresh">🔄 Làm mới danh sách</button>
                
                <div class="jjs-status">
                    <div class="jjs-dot" id="jjs-dot"></div>
                    <span class="jjs-status-text" id="jjs-status-text">Chưa kích hoạt</span>
                </div>
                
                <button class="jjs-toggle off" id="jjs-toggle" disabled>▶ KÍCH HOẠT</button>
                
                <div class="jjs-info">F5: Mở/Đóng GUI | Kéo thả để di chuyển</div>
            </div>
        `;
        
        document.body.appendChild(guiElement);
        
        // Event listeners
        document.getElementById('jjs-close').addEventListener('click', () => {
            guiElement.style.display = 'none';
        });
        
        document.getElementById('jjs-toggle').addEventListener('click', toggle);
        document.getElementById('jjs-refresh').addEventListener('click', updateList);
        
        // Drag
        const header = document.getElementById('jjs-header');
        header.addEventListener('mousedown', (e) => {
            if (e.target.tagName === 'BUTTON') return;
            isDragging = true;
            const rect = guiElement.getBoundingClientRect();
            dragOffsetX = e.clientX - rect.left;
            dragOffsetY = e.clientY - rect.top;
            e.preventDefault();
        });
        
        document.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            guiElement.style.left = (e.clientX - dragOffsetX) + 'px';
            guiElement.style.top = (e.clientY - dragOffsetY) + 'px';
            guiElement.style.right = 'auto';
        });
        
        document.addEventListener('mouseup', () => { isDragging = false; });
        
        // F5 toggle
        document.addEventListener('keydown', (e) => {
            if (e.key === 'F5') {
                e.preventDefault();
                if (guiElement.style.display === 'none' || guiElement.style.display === '') {
                    guiElement.style.display = 'block';
                    updateList();
                } else {
                    guiElement.style.display = 'none';
                }
            }
        });
        
        updateList();
    }

    async function init() {
        injectStyles();
        await waitForGame();
        createGUI();
        console.log('JJK Chase GUI ready! F5 to open/close.');
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

})();
