-- Noclip function
local function noclip()
    noclipEnabled = true
    task.spawn(function()
        while noclipEnabled do
            if Player.Character then
                for _, part in pairs(Player.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide == true then
                        part.CanCollide = false
                    end
                end
            end
            task.wait()
        end
    end)
end

